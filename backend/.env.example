# Copy this file to .env and fill in real values.
# Never commit .env. This template is safe to commit.

# PostgreSQL connection string
# Format: postgresql+psycopg://user:password@host:port/database_name
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/mediflow

# JWT secret — generate a long random value (e.g. python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# JWT signing algorithm and access-token lifetime in minutes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60